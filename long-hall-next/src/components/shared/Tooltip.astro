---
/**
 * Tooltip.astro - CSS-only tooltip component for contextual information
 * Task ID: C2.1.3
 * 
 * Displays a tooltip on hover with configurable positioning.
 * Uses CSS-only implementation with no JavaScript required.
 * 
 * @example
 * <Tooltip content="Deal 2d6 damage" position="top">
 *   <Button variant="primary">Attack</Button>
 * </Tooltip>
 */

interface Props {
  content: string;
  position?: 'top' | 'bottom' | 'left' | 'right';
  class?: string;
}

const {
  content,
  position = 'top',
  class: className = '',
} = Astro.props;

const classes = [
  'tooltip-wrapper',
  `tooltip--${position}`,
  className,
].filter(Boolean).join(' ');
---

<span class={classes}>
  <slot />
  <span class="tooltip-popup" role="tooltip">
    {content}
  </span>
</span>

<style>
  /* === TOOLTIP WRAPPER === */
  .tooltip-wrapper {
    position: relative;
    display: inline-block;
  }

  /* === TOOLTIP POPUP === */
  .tooltip-popup {
    /* Positioning */
    position: absolute;
    z-index: 50;
    
    /* Sizing */
    width: max-content;
    max-width: 200px;
    
    /* Typography */
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.4;
    text-align: center;
    
    /* Appearance */
    background-color: var(--bg-dark);
    color: #fafaf9; /* Light text for dark bg */
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    
    /* Hidden by default */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    
    /* Transition with delay */
    transition: 
      opacity var(--transition-fast),
      visibility var(--transition-fast);
    transition-delay: 0ms;
  }

  /* === ARROW/CARET (using ::before pseudo-element) === */
  .tooltip-popup::before {
    content: '';
    position: absolute;
    border: 6px solid transparent;
  }

  /* === SHOW ON HOVER === */
  .tooltip-wrapper:hover .tooltip-popup,
  .tooltip-wrapper:focus-within .tooltip-popup {
    opacity: 1;
    visibility: visible;
    transition-delay: 150ms;
  }

  /* === POSITION: TOP === */
  .tooltip--top .tooltip-popup {
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
  }

  .tooltip--top .tooltip-popup::before {
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-top-color: var(--bg-dark);
  }

  /* === POSITION: BOTTOM === */
  .tooltip--bottom .tooltip-popup {
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
  }

  .tooltip--bottom .tooltip-popup::before {
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-bottom-color: var(--bg-dark);
  }

  /* === POSITION: LEFT === */
  .tooltip--left .tooltip-popup {
    right: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%);
  }

  .tooltip--left .tooltip-popup::before {
    left: 100%;
    top: 50%;
    transform: translateY(-50%);
    border-left-color: var(--bg-dark);
  }

  /* === POSITION: RIGHT === */
  .tooltip--right .tooltip-popup {
    left: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%);
  }

  .tooltip--right .tooltip-popup::before {
    right: 100%;
    top: 50%;
    transform: translateY(-50%);
    border-right-color: var(--bg-dark);
  }
</style>
