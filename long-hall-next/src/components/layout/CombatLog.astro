---
/**
 * CombatLog.astro - Combat event history display
 * Task ID: C2.2.4
 * 
 * Displays a scrollable list of game events (combat actions, loot, etc.)
 * with a terminal/console aesthetic. Entries are styled based on their
 * content type (damage, healing, critical hits, misses).
 * 
 * Features:
 * - Dark themed scrollable container
 * - Monospace font for terminal feel
 * - Auto-scroll to newest entry
 * - Fade gradient at top indicating more content
 * - Color-coded entries based on action type
 * 
 * @example
 * <CombatLog 
 *   entries={[
 *     "Fighter attacks Goblin for 8 damage!",
 *     "Goblin attacks Fighter for 3 damage.",
 *     "Cleric heals Fighter for 5 HP.",
 *     "Fighter lands a critical hit for 16 damage!"
 *   ]} 
 *   maxVisible={8}
 * />
 */

interface Props {
  /** Array of log entry strings */
  entries: string[];
  /** Maximum number of visible entries before scrolling (default: 10) */
  maxVisible?: number;
  /** Additional CSS classes */
  class?: string;
}

const { 
  entries, 
  maxVisible = 10, 
  class: className = '' 
} = Astro.props;

const classes = ['combat-log', className].filter(Boolean).join(' ');

/**
 * Determines the entry type based on content keywords.
 * Returns a CSS class for appropriate coloring.
 */
function getEntryType(entry: string): string {
  const lowerEntry = entry.toLowerCase();
  
  if (lowerEntry.includes('critical') || lowerEntry.includes('crit')) {
    return 'entry-crit';
  }
  if (lowerEntry.includes('heal') || lowerEntry.includes('restore') || lowerEntry.includes('recovered')) {
    return 'entry-heal';
  }
  if (lowerEntry.includes('miss') || lowerEntry.includes('dodged') || lowerEntry.includes('evaded')) {
    return 'entry-miss';
  }
  if (lowerEntry.includes('damage') || lowerEntry.includes('hit') || lowerEntry.includes('struck')) {
    return 'entry-damage';
  }
  
  return 'entry-default';
}

// Calculate dynamic height based on maxVisible entries
// Approximate 1.5rem line height + padding per entry
const lineHeight = 1.5; // rem
const entryPadding = 0.25; // rem (top + bottom)
const containerHeight = maxVisible * (lineHeight + entryPadding);
---

<div class={classes} style={`--max-height: ${containerHeight}rem;`}>
  <h4 class="log-header">
    <span class="header-icon">⚔</span>
    Combat Log
  </h4>
  <div class="log-entries" data-combat-log>
    {entries.map((entry, index) => (
      <p 
        class={`log-entry ${getEntryType(entry)}`}
        data-entry-index={index}
      >
        <span class="entry-marker">›</span>
        {entry}
      </p>
    ))}
  </div>
  <div class="fade-overlay" aria-hidden="true"></div>
</div>

<script>
  /**
   * Auto-scroll combat log to the bottom on load and when entries change.
   * Uses MutationObserver to detect new entries.
   */
  function initCombatLog() {
    const logContainers = document.querySelectorAll('[data-combat-log]');
    
    logContainers.forEach(container => {
      // Scroll to bottom immediately
      container.scrollTop = container.scrollHeight;
      
      // Set up observer for new entries
      const observer = new MutationObserver(() => {
        container.scrollTop = container.scrollHeight;
      });
      
      observer.observe(container, {
        childList: true,
        subtree: true
      });
    });
  }
  
  // Run on load
  initCombatLog();
  
  // Re-run on Astro view transitions
  document.addEventListener('astro:page-load', initCombatLog);
</script>

<style>
  /* === COMBAT LOG CONTAINER === */
  .combat-log {
    /* Layout */
    display: flex;
    flex-direction: column;
    position: relative;
    
    /* Appearance - Terminal/console aesthetic */
    background-color: var(--bg-dark);
    border-radius: var(--radius-md);
    
    /* Sizing */
    width: 100%;
    max-height: var(--max-height, 15rem);
    
    /* Subtle shadow */
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  /* === LOG HEADER === */
  .log-header {
    /* Typography */
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    
    /* Color */
    color: var(--copper-light);
    
    /* Spacing */
    margin: 0;
    padding: var(--space-2) var(--space-3);
    
    /* Border */
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    
    /* Layout */
    display: flex;
    align-items: center;
    gap: var(--space-2);
    
    /* Don't shrink */
    flex-shrink: 0;
  }

  .header-icon {
    font-size: 0.875rem;
    opacity: 0.8;
  }

  /* === LOG ENTRIES CONTAINER === */
  .log-entries {
    /* Layout */
    display: flex;
    flex-direction: column;
    
    /* Spacing */
    padding: var(--space-2) var(--space-3);
    padding-top: var(--space-3); /* Extra space for fade gradient */
    
    /* Scrollable */
    overflow-y: auto;
    flex: 1;
    min-height: 0;
    
    /* Smooth scrolling */
    scroll-behavior: smooth;
  }

  /* === SCROLLBAR STYLING === */
  .log-entries::-webkit-scrollbar {
    width: 6px;
  }

  .log-entries::-webkit-scrollbar-track {
    background: transparent;
  }

  .log-entries::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-lg);
  }

  .log-entries::-webkit-scrollbar-thumb:hover {
    background-color: rgba(255, 255, 255, 0.3);
  }

  /* Firefox scrollbar */
  .log-entries {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }

  /* === LOG ENTRY === */
  .log-entry {
    /* Typography */
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    
    /* Color - Default light text */
    color: rgba(255, 255, 255, 0.85);
    
    /* Spacing */
    margin: 0;
    padding: var(--space-1) 0;
    
    /* Layout */
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    
    /* Subtle transition for added entries */
    transition: opacity var(--transition-normal);
  }

  .entry-marker {
    color: var(--text-muted);
    opacity: 0.5;
    flex-shrink: 0;
  }

  /* === ENTRY TYPE COLORS === */
  .entry-damage {
    color: var(--damage);
  }

  .entry-heal {
    color: var(--heal);
  }

  .entry-crit {
    color: var(--crit);
    font-weight: 600;
  }

  .entry-miss {
    color: var(--miss);
    font-style: italic;
  }

  .entry-default {
    color: rgba(255, 255, 255, 0.85);
  }

  /* === FADE OVERLAY === */
  .fade-overlay {
    /* Positioning */
    position: absolute;
    top: 2rem; /* Below header */
    left: 0;
    right: 6px; /* Don't cover scrollbar */
    height: 1.5rem;
    
    /* Gradient fade */
    background: linear-gradient(
      to bottom,
      var(--bg-dark) 0%,
      transparent 100%
    );
    
    /* Non-interactive */
    pointer-events: none;
    
    /* Smooth appearance */
    opacity: 0.9;
  }

  /* === EMPTY STATE === */
  .log-entries:empty::before {
    content: 'No events yet...';
    color: var(--text-muted);
    font-style: italic;
    font-size: 0.8125rem;
    padding: var(--space-4) 0;
    text-align: center;
  }

  /* === RESPONSIVE: Tablet === */
  @media (max-width: 1024px) {
    .combat-log {
      max-height: calc(var(--max-height, 15rem) * 0.8);
    }

    .log-entry {
      font-size: 0.75rem;
    }
  }

  /* === RESPONSIVE: Mobile === */
  @media (max-width: 640px) {
    .log-header {
      padding: var(--space-2);
      font-size: 0.6875rem;
    }

    .log-entries {
      padding: var(--space-2);
    }

    .log-entry {
      font-size: 0.6875rem;
    }
  }
</style>
