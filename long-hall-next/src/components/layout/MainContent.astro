---
/**
 * MainContent.astro - Central game area container
 * Task ID: C2.2.3
 * 
 * Provides the main content area with slots for room display and action buttons.
 * Uses a flexible layout where the room area takes the majority of vertical space
 * and the actions area stays fixed at the bottom.
 * 
 * @slot room - For RoomDisplay component
 * @slot actions - For ActionButtons component (sticky at bottom)
 * @slot default - Any additional content
 * 
 * @example
 * <MainContent>
 *   <RoomDisplay slot="room" room={currentRoom} theme="dungeon" />
 *   <ActionButtons slot="actions" actions={['Attack', 'Flee', 'Rest']} />
 * </MainContent>
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const classes = ['main-content', className].filter(Boolean).join(' ');
---

<main class={classes}>
  <section class="room-area">
    <slot name="room" />
  </section>
  <section class="actions-area">
    <slot name="actions" />
  </section>
  <slot />
</main>

<style>
  /* === MAIN CONTENT CONTAINER === */
  .main-content {
    /* Layout - Flex column to stack room and actions */
    display: flex;
    flex-direction: column;
    
    /* Sizing - Fill available space */
    flex: 1;
    min-width: 0; /* Prevent flex item from overflowing */
    height: 100%;
    
    /* Appearance */
    background-color: var(--bg-primary);
    border-radius: var(--radius-lg);
    
    /* Overflow handling */
    overflow: hidden;
    position: relative;
  }

  /* === ROOM AREA === */
  .room-area {
    /* Layout - Takes majority of space */
    flex: 1;
    display: flex;
    flex-direction: column;
    
    /* Spacing */
    padding: var(--space-6);
    
    /* Scrollable if content overflows */
    overflow-y: auto;
    overflow-x: hidden;
    
    /* Prevent shrinking below content */
    min-height: 0;
  }

  /* === SCROLLBAR STYLING (Room Area) === */
  .room-area::-webkit-scrollbar {
    width: 8px;
  }

  .room-area::-webkit-scrollbar-track {
    background: transparent;
  }

  .room-area::-webkit-scrollbar-thumb {
    background-color: var(--border-light);
    border-radius: var(--radius-lg);
  }

  .room-area::-webkit-scrollbar-thumb:hover {
    background-color: var(--text-muted);
  }

  /* Firefox scrollbar */
  .room-area {
    scrollbar-width: thin;
    scrollbar-color: var(--border-light) transparent;
  }

  /* === ACTIONS AREA === */
  .actions-area {
    /* Layout - Fixed at bottom, doesn't shrink */
    flex-shrink: 0;
    
    /* Spacing */
    padding: var(--space-4) var(--space-6);
    
    /* Appearance - Subtle separation from room area */
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-light);
    
    /* Ensure actions stay visible */
    position: sticky;
    bottom: 0;
    z-index: 10;
  }

  /* === RESPONSIVE: Tablet === */
  @media (max-width: 1024px) {
    .room-area {
      padding: var(--space-4);
    }

    .actions-area {
      padding: var(--space-3) var(--space-4);
    }
  }

  /* === RESPONSIVE: Mobile === */
  @media (max-width: 640px) {
    .main-content {
      border-radius: 0;
    }

    .room-area {
      padding: var(--space-3);
    }

    .actions-area {
      padding: var(--space-3);
    }
  }
</style>
