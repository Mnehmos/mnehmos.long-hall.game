---
/**
 * GameOver.astro - Overlay component for displaying run statistics when party is defeated
 * Task ID: C2.6.1
 * 
 * @example
 * <GameOver runStats={stats}>
 *   <Button variant="primary">Try Again</Button>
 *   <Button variant="secondary">Main Menu</Button>
 * </GameOver>
 */

interface Props {
  runStats: {
    depth: number;
    gold: number;
    enemiesKilled: number;
    bossesDefeated: number;
    finalScore: number;
    runDuration?: string;
  };
  class?: string;
}

const { runStats, class: className = '' } = Astro.props;

const overlayClasses = [
  'game-over-overlay',
  className,
].filter(Boolean).join(' ');
---

<div class={overlayClasses} role="dialog" aria-modal="true" aria-labelledby="game-over-title">
  <div class="game-over-modal">
    <!-- Header with skull decoration -->
    <div class="game-over-header">
      <span class="skull-icon">💀</span>
      <h1 id="game-over-title" class="title">Game Over</h1>
      <span class="skull-icon">💀</span>
    </div>
    
    <p class="subtitle">Your party has fallen...</p>
    
    <!-- Run Statistics Grid -->
    <div class="stats-grid">
      <div class="stat-item">
        <span class="stat-value">{runStats.depth}</span>
        <span class="stat-label">Depth Reached</span>
      </div>
      <div class="stat-item">
        <span class="stat-value">{runStats.enemiesKilled}</span>
        <span class="stat-label">Enemies Slain</span>
      </div>
      <div class="stat-item">
        <span class="stat-value">{runStats.bossesDefeated}</span>
        <span class="stat-label">Bosses Defeated</span>
      </div>
      <div class="stat-item gold">
        <span class="stat-value">💰 {runStats.gold}</span>
        <span class="stat-label">Gold Collected</span>
      </div>
    </div>
    
    <!-- Optional Run Duration -->
    {runStats.runDuration && (
      <div class="run-duration">
        <span class="duration-label">Time Survived:</span>
        <span class="duration-value">{runStats.runDuration}</span>
      </div>
    )}
    
    <!-- Final Score Display -->
    <div class="final-score">
      <span class="score-label">Final Score</span>
      <span class="score-value">{runStats.finalScore.toLocaleString()}</span>
    </div>
    
    <!-- Action Buttons Slot -->
    <div class="actions">
      <slot />
    </div>
  </div>
</div>

<style>
  /* === OVERLAY BACKDROP === */
  .game-over-overlay {
    /* Positioning - Full viewport overlay */
    position: fixed;
    inset: 0;
    z-index: 200;
    
    /* Layout - Center modal */
    display: flex;
    align-items: center;
    justify-content: center;
    
    /* Dark overlay with red tint for death theme */
    background: linear-gradient(
      to bottom,
      rgba(20, 10, 10, 0.92),
      rgba(30, 15, 15, 0.95)
    );
    
    /* Entrance animation */
    animation: fade-in var(--transition-slow) ease-out forwards;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* === MODAL CONTAINER === */
  .game-over-modal {
    /* Sizing */
    width: 90%;
    max-width: 450px;
    max-height: 90vh;
    overflow-y: auto;
    
    /* Appearance */
    background-color: var(--bg-card);
    border: 2px solid var(--damage);
    border-radius: var(--radius-lg);
    box-shadow: 
      var(--shadow-lg),
      0 0 40px rgba(239, 68, 68, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    
    /* Layout */
    padding: var(--space-6);
    text-align: center;
    
    /* Entrance animation */
    animation: slide-up var(--transition-slow) ease-out forwards;
  }

  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* === HEADER WITH SKULLS === */
  .game-over-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }

  .skull-icon {
    font-size: 1.5rem;
    opacity: 0.8;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.6;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  /* === TITLE === */
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--damage);
    text-shadow: 0 2px 10px rgba(239, 68, 68, 0.4);
    letter-spacing: 0.05em;
  }

  /* === SUBTITLE === */
  .subtitle {
    margin: var(--space-2) 0 var(--space-6);
    font-family: var(--font-body);
    font-size: 1rem;
    font-style: italic;
    color: var(--text-muted);
  }

  /* === STATS GRID === */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding: var(--space-4);
    background-color: var(--bg-secondary);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-light);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
    background-color: var(--bg-card);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-light);
    transition: transform var(--transition-fast);
  }

  .stat-item:hover {
    transform: translateY(-2px);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Gold stat special styling */
  .stat-item.gold .stat-value {
    color: var(--gold);
  }

  /* === RUN DURATION === */
  .run-duration {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .duration-value {
    color: var(--text-secondary);
    font-weight: 500;
  }

  /* === FINAL SCORE === */
  .final-score {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    margin-bottom: var(--space-6);
    background: linear-gradient(
      135deg,
      rgba(139, 92, 246, 0.1),
      rgba(139, 92, 246, 0.05)
    );
    border: 2px solid var(--xp);
    border-radius: var(--radius-md);
    box-shadow: 0 0 20px rgba(139, 92, 246, 0.15);
  }

  .score-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--xp);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .score-value {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--xp);
    text-shadow: 0 2px 10px rgba(139, 92, 246, 0.3);
    animation: score-glow 2s ease-in-out infinite alternate;
  }

  @keyframes score-glow {
    from {
      text-shadow: 0 2px 10px rgba(139, 92, 246, 0.3);
    }
    to {
      text-shadow: 0 2px 20px rgba(139, 92, 246, 0.5);
    }
  }

  /* === ACTION BUTTONS === */
  .actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Responsive: horizontal on larger screens */
  @media (min-width: 400px) {
    .actions {
      flex-direction: row;
      justify-content: center;
    }
  }

  /* Hide actions when empty (no slot content) */
  .actions:empty {
    display: none;
  }

  /* === DARK MODE ADJUSTMENTS === */
  :global(.dark) .game-over-overlay {
    background: linear-gradient(
      to bottom,
      rgba(10, 5, 5, 0.95),
      rgba(15, 8, 8, 0.98)
    );
  }

  :global(.dark) .stats-grid {
    background-color: rgba(0, 0, 0, 0.3);
    border-color: var(--border-light);
  }

  :global(.dark) .stat-item {
    background-color: var(--bg-card);
    border-color: var(--border-light);
  }

  :global(.dark) .final-score {
    background: linear-gradient(
      135deg,
      rgba(139, 92, 246, 0.15),
      rgba(139, 92, 246, 0.08)
    );
  }
</style>
