---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  centered?: boolean;
}

const { title, description, centered = true } = Astro.props;
---

<Layout title={title} description={description}>
  <div class:list={[
    "menu-container min-h-screen flex flex-col",
    centered && "items-center justify-center"
  ]}>
    <!-- Optional background slot for art/effects -->
    <div class="menu-background absolute inset-0 z-0 overflow-hidden">
      <slot name="background" />
    </div>
    
    <!-- Main content area -->
    <main class="menu-main relative z-10 w-full max-w-2xl px-4 py-8">
      <slot />
    </main>
    
    <!-- Footer area -->
    <footer class="menu-footer relative z-10 text-center text-sm opacity-60 py-4 mt-auto">
      <slot name="footer" />
    </footer>
  </div>
</Layout>

<style>
  .menu-container {
    /* Ensure proper stacking context */
    position: relative;
  }
  
  .menu-background {
    pointer-events: none;
  }
  
  .menu-main {
    /* Subtle animation for menu entrance */
    animation: fadeInUp 0.3s ease-out;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .menu-footer {
    /* Ensure footer stays at bottom when content is short */
    flex-shrink: 0;
  }
</style>
